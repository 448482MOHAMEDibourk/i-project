#.gitignore for project
# Python envs and caches
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Ignore converted lesson planner JSON data
/new-project/ai-school/lessons/imported-from-failed/lesson-planner/data/converted/

# Local test virtualenv used by CI/dev runs
.venv-test/

# Dry-run / codemod artifacts
.tmp_g12_refactor*

# Temporary partition/dryrun outputs
.tmp_partition_dryrun/

# Backups and miscellaneous
backup/

# Bytecode caches
__pycache__/
*.pyc
